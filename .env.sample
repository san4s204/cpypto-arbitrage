# MVP-1 uses public market data and never places real orders.
BOT_MODE=paper
MARKET_DATA_MODE=ws

EXCHANGES=bybit,okx
SYMBOLS=BTC/USDT,ETH/USDT
RISK_PROFILE=conservative

# Paper balance is denominated in USDT, not RUB.
PAPER_INITIAL_EQUITY=3000
PAPER_FEE_BPS=bybit:10,okx:10,bitget:10,mexc:10
PAPER_SLIPPAGE_BPS=2
PAPER_DB_PATH=runtime/paper_trading.sqlite3

# Optional notifications. Leave blank to run without Telegram.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_IDS=
STATS_INTERVAL_SECONDS=60

# Exchange API keys are intentionally absent until MVP-3.
